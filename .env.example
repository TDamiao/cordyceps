# ==============================================================================
# Cordyceps - Environment Variables Configuration
# ==============================================================================

# --- NordVPN (Gluetun) Configuration ---
# Obtenha o Service Username e Password no painel da NordVPN (Manual setup / Service credentials):
NORDVPN_SERVICE_USER=seu_codigo_username_longo_aqui
NORDVPN_SERVICE_PASSWORD=seu_codigo_password_longo_aqui
NORDVPN_COUNTRY=Brazil

# --- PostgreSQL Database ---
POSTGRES_PASSWORD=sua_senha_forte_aqui
DATABASE_URL=postgresql+psycopg://cordyceps:${POSTGRES_PASSWORD}@postgres:5432/cordyceps

# --- App & Security ---
PORT=8000
ADMIN_TOKEN=defina_um_token_forte_aqui
LOG_FORMAT=json
LOG_LEVEL=INFO

# --- Trading Mode ---
# paper | live_test | live
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
DRY_RUN=true
KILL_SWITCH=false

# --- Polymarket CLOB & Wallet (Necessários apenas para Live / Live Test) ---
PRIVATE_KEY=
PROXY_ADDRESS=
SIGNATURE_TYPE=1
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=
POLYGON_RPC_URL=https://polygon-rpc.com
CHAIN_ID=137

# --- Risk & Execution Limits ---
MAX_TRADE_USD=1
MAX_TOTAL_EXPOSURE_USD=2
MAX_DAILY_LOSS_USD=1
MAX_OPEN_TRADES=1
MAX_LEG_IMBALANCE_USD=1
LEG_TIMEOUT_MS=2000
MIN_PROFIT_THRESHOLD=0.005
MIN_NET_EDGE=0.01
MIN_NET_PROFIT_USD=0.01
MAX_SLIPPAGE_PCT=0.005
EMERGENCY_SLIPPAGE_PCT=0.01
ORDERBOOK_STALE_MS=3000
MIN_TRADE_SHARES=1
SIMULATED_LATENCY_MS=250
MARKET_LIMIT=50
SCAN_INTERVAL_SECONDS=60

# --- Favorite Compounding Strategy ---
# Ativa/desativa a estratégia de favorite compounding (mercados 85-98¢ próximos à resolução)
ENABLE_FAVORITE_STRATEGY=false
# Probabilidade mínima implícita do favorito (0.80-0.99)
MIN_FAVORITE_PROBABILITY=0.90
# Preço mínimo do favorito em dólares (0.70-0.95)
MIN_FAVORITE_PRICE=0.85
# Preço máximo do favorito em dólares (0.90-0.99)
MAX_FAVORITE_PRICE=0.98
# Tamanho mínimo de exposição em USD
MIN_FAVORITE_SIZE_USD=5.0
# Take profit em preço (0.90-0.99)
FAVORITE_TAKE_PROFIT=0.97
# Stop loss em preço (0.50-0.90)
FAVORITE_STOP_LOSS=0.80
# Exposição máxima como % da banca (0.10-0.50)
MAX_FAVORITE_EXPOSURE_PCT=0.30
# Fração de Kelly (0.05-1.0), 0.25 = quarter-Kelly
FAVORITE_KELLY_FRACTION=0.25

# --- Telegram Notifications ---
# Token do bot Telegram (obter em BotFather)
TELEGRAM_BOT_TOKEN=
# Chat ID do usuário (seu ID numérico do Telegram)
TELEGRAM_CHAT_ID=
