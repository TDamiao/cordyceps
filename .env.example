# =============================================================================
# Polymarket Arbitrage Bot - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Your EOA (Externally Owned Account) private key
# This is used for L1 authentication to create/derive API keys
# Format: 0x followed by 64 hex characters
PRIVATE_KEY=0x_your_private_key_here

# Your Polymarket Proxy Wallet Address (Gnosis Safe)
# Get this from polymarket.com/settings after logging in
PROXY_ADDRESS=0x_your_proxy_wallet_address_here

# -----------------------------------------------------------------------------
# API Credentials (Optional - auto-derived if not set)
# -----------------------------------------------------------------------------
# These are L2 credentials, can be derived from your private key
# If not set, the bot will auto-derive them on startup
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# -----------------------------------------------------------------------------
# Network Configuration
# -----------------------------------------------------------------------------
# Polygon RPC URL (for contract interactions)
# Recommended: Use a paid RPC like Alchemy or Infura for reliability
POLYGON_RPC_URL=https://polygon-rpc.com

# Chain ID (137 = Polygon Mainnet, 80001 = Mumbai Testnet)
CHAIN_ID=137

# -----------------------------------------------------------------------------
# Trading Configuration
# -----------------------------------------------------------------------------
# Minimum profit threshold (as decimal, e.g., 0.005 = 0.5%)
MIN_PROFIT_THRESHOLD=0.005

# Maximum position size per trade in USDC
MAX_POSITION_SIZE=100

# Enable dry run mode (logs trades without executing)
DRY_RUN=true

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log format: json, console
LOG_FORMAT=console
